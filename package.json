{
  "name": "konutarsa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KonutArsa — konut ve arsa almadan önce araştırma yapılmasını sağlayan bağımsız içerik platformu.",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm images:prepare && astro dev",
    "start": "astro dev",
    "check": "astro check && pnpm lint && pnpm content:validate",
    "build": "pnpm robots:generate && pnpm ads:generate && pnpm headers:generate && pnpm images:prepare && astro check && astro build && pnpm search:build && pnpm links:check && pnpm output:check",
    "preview": "astro preview",
    "preview:search": "pnpm build && astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "node scripts/validate-content.mjs",
    "content:stale": "node scripts/find-stale-content.mjs",
    "locations:import": "node scripts/import-locations.mjs",
    "images:prepare": "node scripts/optimize-images.mjs",
    "search:build": "pagefind --site dist",
    "output:check": "node scripts/check-build-output.mjs",
    "links:check": "node scripts/check-links.mjs",
    "robots:generate": "node scripts/generate-robots.mjs",
    "ads:generate": "node scripts/generate-ads-txt.mjs",
    "headers:generate": "node scripts/generate-headers.mjs",
    "indexnow:key": "node scripts/generate-indexnow-key.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "astro": "7.1.6",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.1",
    "astro-eslint-parser": "3.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.8.0",
    "gray-matter": "4.0.3",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "xlsx": "0.18.5"
  }
}
