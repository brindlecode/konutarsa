---
interface Props {
  sponsorName: string;
  disclosure: string;
}
const { sponsorName, disclosure } = Astro.props;
---

<div class="sponsor-disclosure" role="note" aria-label="Sponsorlu içerik bildirimi">
  <span class="badge badge-warning">Sponsorlu içerik</span>
  <p><strong>{sponsorName}</strong> — {disclosure}</p>
</div>

<style>
  .sponsor-disclosure {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
    background-color: var(--color-warning-bg);
    border: 1px solid var(--color-warning-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .sponsor-disclosure p {
    font-size: var(--text-sm);
    color: var(--color-text);
    max-width: none;
  }
</style>
