---
import ArticleCard from '../cards/ArticleCard.astro';
import type { ContentSummary } from '../../lib/content';

interface Props {
  items: ContentSummary[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="related-content" aria-labelledby="related-content-heading" data-pagefind-ignore>
      <h2 id="related-content-heading">İlgili içerikler</h2>
      <div class="related-grid">
        {items.map((item) => (
          <ArticleCard item={item} headingLevel="h4" />
        ))}
      </div>
    </section>
  )
}

<style>
  .related-content h2 {
    margin-bottom: var(--space-4);
  }
  .related-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
</style>
