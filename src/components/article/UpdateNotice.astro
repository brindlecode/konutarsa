---
import { formatDateLong, daysBetween } from '../../lib/dates';

interface Props {
  publishedAt: Date;
  updatedAt?: Date;
}
const { publishedAt, updatedAt } = Astro.props;

const isMeaningfulUpdate = Boolean(updatedAt) && daysBetween(publishedAt, updatedAt) >= 3;
---

{
  isMeaningfulUpdate && updatedAt && (
    <p class="update-notice">
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 12a9 9 0 1 1-3-6.7" />
        <path d="M21 4v5h-5" />
      </svg>
      Bu içerik <strong>{formatDateLong(updatedAt)}</strong> tarihinde güncellendi.
    </p>
  )
}

<style>
  .update-notice {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-warning-bg);
    color: var(--color-warning);
    border: 1px solid var(--color-warning-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    width: fit-content;
  }
</style>
