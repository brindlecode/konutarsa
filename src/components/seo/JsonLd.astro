---
/**
 * Bir veya birden fazla JSON-LD nesnesini güvenli biçimde render eder.
 * "<" karakteri "<" olarak kaçırılır; bir alan içeriğinde "</script>"
 * geçiyorsa script bloğunun erken kapanmasını önler.
 */
interface Props {
  data: object | object[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---

{
  items.map((item) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(item).replace(/</g, '\\u003c')}
      is:inline
    />
  ))
}
