---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a
  href="/arama/"
  class:list={['search-button', className]}
  data-search-button
  aria-label="Sitede ara"
>
  <svg
    aria-hidden="true"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="search-button-label">Ara</span>
</a>

<style>
  .search-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text);
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
  }
  .search-button:hover {
    background-color: var(--color-surface-muted);
    color: var(--color-text);
  }
  .search-button-label {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  @media (max-width: 30rem) {
    .search-button-label {
      display: none;
    }
  }
</style>
