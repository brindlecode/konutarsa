# KonutArsa - ortam değişkenleri örneği
# Bu dosyayı kopyalayip ".env" adiyla kaydedin: cp .env.example .env
# Gercek gizli anahtarlari asla bu dosyaya ya da repository'ye yazmayin.

# --- Site ---
# Canonical site adresi. Sonunda "/" OLMAMALI.
PUBLIC_SITE_URL=https://konutarsa.com

# Build ortamini belirtir: "production" | "preview" | "development"
# Cloudflare Pages production branch disindaki tum build'lerde otomatik
# olarak preview kabul edilir (bkz. src/lib/env.ts). Bu degiskeni yalnizca
# Cloudflare disinda manuel build aliyorsaniz elle ayarlayin.
PUBLIC_BUILD_ENV=production

# --- Google AdSense (varsayilan kapali) ---
# Onay alinmadan ve gercek ID girilmeden bu bolumu doldurmayin.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
PUBLIC_ADSENSE_SLOT_ARTICLE_MIDDLE=
PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# --- Google Analytics 4 (istege bagli, varsayilan kapali) ---
PUBLIC_GA_ENABLED=false
PUBLIC_GA_MEASUREMENT_ID=

# --- Cloudflare Web Analytics (istege bagli) ---
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# --- Arama motoru dogrulama ---
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# --- IndexNow (istege bagli, varsayilan kapali) ---
INDEXNOW_ENABLED=false
INDEXNOW_KEY=

# --- AI / arama botu erisim tercihleri ---
# Genel arama botlarina (Googlebot, Bingbot vb.) izin ver
ALLOW_SEARCH_CRAWLERS=true
# Yapay zeka egitim botlarina (GPTBot vb.) izin verme
ALLOW_TRAINING_CRAWLERS=false
